# Frigate-MCP Environment Configuration
FRIGATE_MCP_ENV=development
FRIGATE_MCP_LOG_LEVEL=info
FRIGATE_MCP_PORT=5000
FRIGATE_MCP_HOST=0.0.0.0
FRIGATE_MCP_DEBUG=false
FRIGATE_MCP_WORKERS=1
FRIGATE_MCP_TIMEOUT=30
FRIGATE_MCP_CONFIG=./config/config.yml
FRIGATE_MCP_LOG_FILE=./logs/frigate-mcp.log
FRIGATE_MCP_DATA=./data
FRIGATE_MCP_CACHE=./cache

# Frigate NVR Target Connection
FRIGATE_URL=http://localhost:5000
FRIGATE_TIMEOUT=5.0
FRIGATE_SIMULATION_MODE=auto

# Redis State Cache
REDIS_URL=redis://localhost:6379/0

# MQTT Broker (Optional)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
